@model IReadOnlyList<Category>

@{
    ViewData["Title"] = "Book categories";
}

<h1 class="mt-4">Book categories</h1>
<p><a asp-action="Browse">Browse all books</a></p>
<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var category in Model)
    {
        <div class="col">
            <a class="card catalog-card text-decoration-none h-100" asp-action="Browse" asp-route-category="@category.Name">
                <span class="card-body fs-4">@category.Name</span>
            </a>
        </div>
    }
</div>
