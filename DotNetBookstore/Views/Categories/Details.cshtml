@model Book

@{
    ViewData["Title"] = Model.Title;
}

<article class="book-details my-4">
    <p class="mb-2"><a asp-action="Browse" asp-route-category="@Model.Category.Name">@Model.Category.Name</a></p>
    <h1>@Model.Title</h1>
    <partial name="_BookCover" model="Model" />
    <p class="lead">By @Model.Author</p>
    <p>@Model.Description</p>
    <p class="fw-semibold">@Model.PriceLabel</p>
    <form class="d-inline" asp-controller="Cart" asp-action="Add" asp-route-id="@Model.BookId" method="post">
        <button class="btn btn-dark" type="submit">Add to cart</button>
    </form>
    <a class="btn btn-outline-dark" asp-action="Browse">Browse all books</a>
</article>
