@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "My orders";
}

<h1 class="mt-4">My orders</h1>
@if (TempData["OrderMessage"] is string message)
{
    <p class="alert alert-success" role="status">@message</p>
}

@if (Model.Count == 0)
{
    <p>You haven’t placed a demo order yet.</p>
    <a class="btn btn-dark" asp-controller="Categories" asp-action="Browse">Browse books</a>
}

<div class="vstack gap-3 my-4">
    @foreach (var order in Model)
    {
        <article class="card catalog-card">
            <div class="card-body">
                <h2 class="h5">Order #@order.OrderId</h2>
                <p>@order.PlacedAtUtc.ToString("MMM d, yyyy") (UTC)</p>
                <ul>
                    @foreach (var line in order.Lines.OrderBy(line => line.OrderLineId))
                    {
                        <li>@line.Quantity × @line.Title (@Book.FormatPrice(line.UnitPriceCents) each)</li>
                    }
                </ul>
                <p class="mb-0 fw-semibold">Total @Book.FormatPrice(order.Lines.Sum(line => (long)line.Quantity * line.UnitPriceCents))</p>
            </div>
        </article>
    }
</div>
